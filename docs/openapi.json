{
  "components": {
    "schemas": {
      "APIToken": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "username",
          "name",
          "prefix",
          "role",
          "createdAt"
        ],
        "type": "object"
      },
      "AuditEntry": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "ok": {
            "type": "boolean"
          },
          "remote": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "time",
          "actor",
          "action",
          "target",
          "ok"
        ],
        "type": "object"
      },
      "Change-passwordRequest": {
        "additionalProperties": false,
        "properties": {
          "current": {
            "type": "string"
          },
          "new": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "current",
          "new"
        ],
        "type": "object"
      },
      "Create-tokenRequest": {
        "additionalProperties": false,
        "properties": {
          "expiresInDays": {
            "description": "0 means never",
            "format": "int64",
            "maximum": 3650,
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "description": "Limit the token to this role; defaults to your role",
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Create-userRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._@-]+$",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ],
        "type": "object"
      },
      "CreatedToken": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "token": {
            "description": "The token value. It is only shown once.",
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "id",
          "userId",
          "username",
          "name",
          "prefix",
          "role",
          "createdAt"
        ],
        "type": "object"
      },
      "CredsBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "MeBody": {
        "additionalProperties": false,
        "properties": {
          "authMethod": {
            "enum": [
              "session",
              "token"
            ],
            "type": "string"
          },
          "role": {
            "description": "Effective role (an API token may be limited below its user's role)",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user",
          "role",
          "authMethod"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "needsSetup": {
            "description": "True when no users exist and the first admin can be created with POST /v1/setup",
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "needsSetup",
          "authenticated"
        ],
        "type": "object"
      },
      "Update-userRequest": {
        "additionalProperties": false,
        "properties": {
          "disabled": {
            "type": "boolean"
          },
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "disabled",
          "createdAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "API token (rm_...)",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "in": "cookie",
        "name": "rabmin_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "rabmin API plane: manage and monitor RabbitMQ clusters.\n\nAuthenticate with a session cookie (POST /api/v1/auth/login) or an API token sent as `Authorization: Bearer rm_...`.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "rabmin",
    "version": "0.1.0-dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audit": {
      "get": {
        "description": "Every change made through rabmin, newest first. Page with `before` set to the last id you received.\n\nRequires role: **admin**.",
        "operationId": "list-audit",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "actor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Action prefix, e.g. delete-",
            "explode": false,
            "in": "query",
            "name": "action",
            "schema": {
              "description": "Action prefix, e.g. delete-",
              "type": "string"
            }
          },
          {
            "description": "Substring of the target path",
            "explode": false,
            "in": "query",
            "name": "target",
            "schema": {
              "description": "Substring of the target path",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "before",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "format": "int64",
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Audit log",
        "tags": [
          "Audit"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Log in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "in": "cookie",
            "name": "rabmin_session",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Log out",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/me": {
      "get": {
        "description": "Requires role: **viewer**.",
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Current user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/password": {
      "put": {
        "description": "Requires role: **viewer**.",
        "operationId": "change-password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change-passwordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change your password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/setup": {
      "post": {
        "description": "Only works while no users exist. Logs the new admin in.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Create the first admin",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "get-status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [],
        "summary": "Server status",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/tokens": {
      "get": {
        "description": "Lists your tokens; admins may pass all=true to list every user's tokens.\n\nRequires role: **viewer**.",
        "operationId": "list-tokens",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "all",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/APIToken"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List API tokens",
        "tags": [
          "Users \u0026 tokens"
        ]
      },
      "post": {
        "description": "Requires role: **viewer**.",
        "operationId": "create-token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create-tokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedToken"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create an API token",
        "tags": [
          "Users \u0026 tokens"
        ]
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "description": "Requires role: **viewer**.",
        "operationId": "delete-token",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Revoke an API token",
        "tags": [
          "Users \u0026 tokens"
        ]
      }
    },
    "/v1/users": {
      "get": {
        "description": "Requires role: **admin**.",
        "operationId": "list-users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/User"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List users",
        "tags": [
          "Users \u0026 tokens"
        ]
      },
      "post": {
        "description": "Requires role: **admin**.",
        "operationId": "create-user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create-userRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a user",
        "tags": [
          "Users \u0026 tokens"
        ]
      }
    },
    "/v1/users/{id}": {
      "delete": {
        "description": "Requires role: **admin**.",
        "operationId": "delete-user",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete a user",
        "tags": [
          "Users \u0026 tokens"
        ]
      },
      "patch": {
        "description": "Requires role: **admin**.",
        "operationId": "update-user",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update-userRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Update a user",
        "tags": [
          "Users \u0026 tokens"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "session": []
    }
  ],
  "servers": [
    {
      "url": "/api"
    }
  ]
}
