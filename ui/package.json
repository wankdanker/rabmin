{
	"name": "rabmin-ui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && touch ../web/dist/.gitkeep",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen:api": "openapi-typescript ../docs/openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@types/node": "^22.20.5",
		"openapi-typescript": "7.13.0",
		"svelte": "5.57.3",
		"svelte-check": "4.3.4",
		"typescript": "5.9.3",
		"vite": "7.3.7"
	},
	"dependencies": {
		"openapi-fetch": "0.17.0"
	},
	"packageManager": "pnpm@10.28.0"
}
